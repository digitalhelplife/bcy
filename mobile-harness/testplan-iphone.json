{
  "url": "https://bencaoyou.tryliang.me/",
  "steps": [
    { "op": "wait", "ms": 7000 },
    { "op": "eval", "name": "env", "js": "return {w: innerWidth, h: innerHeight, dpr: devicePixelRatio, ua: navigator.userAgent, href: location.href, title: document.title};" },
    { "op": "shot", "name": "i01-boot" },

    { "op": "waitFor", "selector": "[data-testid=consent-agree]", "timeout": 30000 },
    { "op": "eval", "name": "consent-initial", "js": "const a=document.querySelector('[data-testid=consent-accept]'); return {acceptDisabled: a ? a.disabled : null, hasAgree: !!document.querySelector('[data-testid=consent-agree]')};" },
    { "op": "tapSel", "selector": "[data-testid=consent-agree]" },
    { "op": "wait", "ms": 600 },
    { "op": "waitEnabled", "selector": "[data-testid=consent-accept]", "timeout": 5000 },
    { "op": "shot", "name": "i02-consent-checked" },
    { "op": "tapSel", "selector": "[data-testid=consent-accept]" },

    { "op": "waitFor", "selector": "[data-testid=enter]", "timeout": 60000 },
    { "op": "shot", "name": "i03-landing" },
    { "op": "tapSel", "selector": "[data-testid=enter]" },

    { "op": "waitText", "text": "都江堰水利工程", "timeout": 30000 },
    { "op": "shot", "name": "i04-map" },
    { "op": "tapText", "text": "寻踪" },
    { "op": "waitFor", "selector": "[data-testid=route-plant]", "timeout": 10000 },
    { "op": "eval", "name": "route-sheet", "js": "return {plant: !!document.querySelector('[data-testid=route-plant]'), decor: !!document.querySelector('[data-testid=route-decor]'), start: !!document.querySelector('[data-testid=start-run]')};" },
    { "op": "shot", "name": "i05-route" },
    { "op": "tapSel", "selector": "[data-testid=route-plant]" },
    { "op": "tapSel", "selector": "[data-testid=start-run]" },

    { "op": "waitCanvas", "timeout": 60000 },
    { "op": "wait", "ms": 1500 },
    { "op": "shot", "name": "i06-find-before" },
    { "op": "shotCanvas", "name": "i06-find-canvas" },
    { "op": "dragWorld", "x1": 610, "y1": 770, "x2": 860, "y2": 900, "steps": 16 },
    { "op": "wait", "ms": 1200 },
    { "op": "shot", "name": "i07-fog-moved" },
    { "op": "tapWorld", "x": 362, "y": 356 },
    { "op": "wait", "ms": 900 },
    { "op": "tapWorld", "x": 500, "y": 812 },
    { "op": "wait", "ms": 900 },
    { "op": "tapWorld", "x": 602, "y": 772 },
    { "op": "waitText", "text": "完成", "timeout": 20000 },
    { "op": "shot", "name": "i08-result" },
    { "op": "eval", "name": "result-text", "js": "return {text: document.body.innerText.slice(0,600)};" },

    { "op": "tapText", "text": "去小院" },
    { "op": "waitCanvas", "timeout": 30000 },
    { "op": "wait", "ms": 1500 },
    { "op": "shot", "name": "i09-garden" },
    { "op": "tapWorld", "x": 124, "y": 1506 },
    { "op": "waitFor", "selector": "[data-testid=plant-seed_mint]", "timeout": 10000 },
    { "op": "shot", "name": "i10-plot-sheet" },
    { "op": "tapSel", "selector": "[data-testid=plant-seed_mint]" },
    { "op": "waitEnabled", "selector": "[data-testid=claim-plant]", "timeout": 20000 },
    { "op": "shot", "name": "i11-matured" },
    { "op": "tapSel", "selector": "[data-testid=claim-plant]" },
    { "op": "waitFor", "selector": "[data-testid=edit-garden]", "timeout": 15000 },
    { "op": "tapSel", "selector": "[data-testid=edit-garden]" },
    { "op": "waitFor", "selector": "[data-testid=garden-auto]", "timeout": 10000 },
    { "op": "tapSel", "selector": "[data-testid=garden-auto]" },
    { "op": "waitText", "text": "摆一摆", "timeout": 5000 },
    { "op": "tapText", "text": "摆一摆" },
    { "op": "wait", "ms": 1200 },
    { "op": "shot", "name": "i12-garden-edit" },
    { "op": "tapSel", "selector": "[data-testid=save-garden]" },
    { "op": "waitText", "text": "已保存", "timeout": 20000 },
    { "op": "shot", "name": "i13-garden-saved" },

    { "op": "tapSel", "selector": "[data-testid=nav-share]" },
    { "op": "waitFor", "selector": "[data-testid=make-share]", "timeout": 15000 },
    { "op": "shot", "name": "i14-journal" },
    { "op": "tapSel", "selector": "[data-testid=make-share]" },
    { "op": "waitFor", "selector": "[data-testid=share-preview]", "timeout": 30000 },
    { "op": "eval", "name": "journal-preview", "js": "const img=document.querySelector('[data-testid=share-preview]'); return {w: img ? img.naturalWidth : null, h: img ? img.naturalHeight : null, src: img ? img.src.slice(0,40) : null};" },
    { "op": "wait", "ms": 800 },
    { "op": "shot", "name": "i15-journal-preview" },

    { "op": "tapSel", "selector": "[data-testid=nav-codex]" },
    { "op": "wait", "ms": 1500 },
    { "op": "shot", "name": "i16-codex" },
    { "op": "tapSel", "selector": "[data-testid=nav-season]" },
    { "op": "wait", "ms": 1500 },
    { "op": "shot", "name": "i17-season" },
    { "op": "tapSel", "selector": "[data-testid=nav-inventory]" },
    { "op": "wait", "ms": 1500 },
    { "op": "shot", "name": "i18-inventory" },
    { "op": "tapSel", "selector": "[data-testid=nav-map]" },
    { "op": "wait", "ms": 1500 },
    { "op": "eval", "name": "final-state", "js": "const s=window.__bcy && window.__bcy.snapshot; return {mode: s ? s.mode : null, phase: s ? s.phase : null, revision: s ? s.stateRevision : null, state: s && s.state ? {levels: s.state.levels, inventory: s.state.inventory, placements: s.state.garden ? s.state.garden.placements.length : null, discovered: s.state.discoveredPlantIds} : null};" },
    { "op": "shot", "name": "i19-final-map" }
  ]
}
