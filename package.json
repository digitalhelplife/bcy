{
  "name": "bencaoyou",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "python3 scripts/build-legal.py && python3 scripts/subset-font.py && node scripts/manus-game-sharing/build.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "manus:build-source": "node scripts/release-gate.mjs && tsc --noEmit && vite build && node scripts/check-size.mjs",
    "build:nakama": "node backend/nakama/build.mjs",
    "test:nakama": "vitest run --config backend/nakama/vitest.remote.config.ts",
    "gate": "node scripts/release-gate.mjs",
    "voice": "node scripts/build-voice.mjs",
    "review:priority": "node scripts/release-gate.mjs && node scripts/review-priority.mjs",
    "review:packet": "node scripts/review-pack.mjs",
    "preflight": "node scripts/release-preflight.mjs",
    "test:inapp": "node scripts/a7-inapp-xhs.mjs",
    "build:admin": "node backend/admin/build.mjs && node scripts/build-admin-snapshot.mjs && node scripts/build-admin-web.mjs",
    "build:admin:api": "node backend/admin/build.mjs",
    "build:admin:web": "node scripts/build-admin-web.mjs",
    "admin:snapshot": "node scripts/build-admin-snapshot.mjs",
    "admin:start": "node backend/admin/build/bencao-admin.mjs",
    "admin:demo": "node scripts/admin-demo-setup.mjs",
    "admin:ingest-clicks": "node scripts/admin-ingest-clicks.mjs",
    "test:admin": "vitest run tests/admin.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.25.12",
    "pg": "^8.23.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.18.0",
  "dependencies": {
    "@heroiclabs/nakama-js": "2.8.0",
    "phaser": "4.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
