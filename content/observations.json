  {
   "plantId": "honeysuckle",
   "stages": [
    {
     "stage": 0,
     "text": "成熟浆果圆形，熟时蓝黑色。"
    },
    {
     "stage": 1,
     "text": "多数种子在散落后的次年春季萌发。"
    },
    {
     "stage": 2,
     "text": "叶片通常成对相对着生在枝条两侧。"
    },
    {
     "stage": 3,
     "text": "花初开白色，后转黄色，花期4—6月。"
    }
   ],
