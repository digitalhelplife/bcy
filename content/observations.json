  {
   "plantId": "plum_blossom",
   "stages": [
    {
     "stage": 0,
     "text": "梅果内有一枚硬核，种子藏在核中。"
    },
    {
     "stage": 1,
     "text": "梅核里藏着种子。播下后先观察盆土是否露出小芽，不用按固定天数倒计时。"
    },
    {
     "stage": 2,
     "text": "叶片多为卵形或椭圆形，边缘有细锯齿。"
    },
    {
     "stage": 3,
     "text": "花先于叶开放，花期冬春；果期多在5—6月。"
    }
   ],
   "reviewStatus": "approved",
   "reviewer": "AI 内容审核（Claude Code）",
