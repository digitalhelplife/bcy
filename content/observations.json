  {
   "plantId": "narcissus",
   "stages": [
    {
     "stage": 0,
     "text": "水仙常用鳞茎分球栽培，成长卡从圆圆的鳞茎开始观察。"
    },
    {
     "stage": 1,
     "text": "鳞茎顶端抽出叶；鳞片储存的养分支持生长。"
    },
    {
     "stage": 2,
     "text": "叶片扁平呈长条形，叶脉平行，叶尖钝。"
    },
    {
     "stage": 3,
     "text": "一枝花葶上多朵花；白色花被中央有黄色副花冠。"
    }
   ],
