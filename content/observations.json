   "plantId": "crabapple",
   "stages": [
    {
     "stage": 0,
     "text": "秋季梨形小果内有种子，果期9—10月。"
    },
    {
     "stage": 1,
     "text": "播种后先观察盆土有没有露出小芽，并把第一天看见芽的日期记下来。"
    },
    {
     "stage": 2,
     "text": "叶片卵形或椭圆形，嫩叶常带紫晕。"
    },
    {
     "stage": 3,
     "text": "开花/成熟：3—4月粉花下垂；小果9—10月成熟。"
    }
   ],
