  {
   "plantId": "rapeseed",
   "stages": [
    {
     "stage": 0,
     "text": "近球形，直径约1.5毫米，黄棕色。"
    },
    {
     "stage": 1,
     "text": "种皮裂开后，先会看见两片小小的子叶；每天看看它有没有把头钻出土。"
    },
    {
     "stage": 2,
     "text": "下部叶片可羽裂，上部叶基部抱茎。"
    },
    {
     "stage": 3,
     "text": "浅黄花后形成线形长角果，果期4—5月。"
    }
   ],
   "reviewStatus": "approved",
