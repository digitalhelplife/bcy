  {
   "plantId": "peony",
   "stages": [
    {
     "stage": 0,
     "text": "种在蓇葖果内，成熟果表有黄褐色硬毛。"
    },
    {
     "stage": 1,
     "text": "播种苗通常次年早春出土，先长1—3片叶。"
    },
    {
     "stage": 2,
     "text": "叶多为二回三出复叶，小叶可见分裂。"
    },
    {
     "stage": 3,
     "text": "开花/成熟：花常单生枝顶，花后结蓇葖果。"
    }
