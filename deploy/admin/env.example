# /etc/bencao-admin/env — mode 600, owned by root:bencao
# The service binds 127.0.0.1 only; nginx terminates TLS and enforces the IP allowlist.

ADMIN_DATABASE_URL=postgresql://bencao_admin_app:CHANGE_ME@127.0.0.1:5432/bencao_admin
NAKAMA_DATABASE_URL=postgresql://bencao_admin_ro_nakama:CHANGE_ME@127.0.0.1:5432/nakama
AUTH_DATABASE_URL=postgresql://bencao_admin_ro_auth:CHANGE_ME@127.0.0.1:5432/bencao_auth

AUTH_BASE_URL=http://127.0.0.1:7360
AUTH_INTERNAL_SECRET=CHANGE_ME_32_CHARS_MINIMUM

ADMIN_PORT=7361
ADMIN_ENV=production
ADMIN_COOKIE_SECURE=1
ADMIN_TRUST_PROXY=1
ADMIN_ALLOW_IPS=203.0.113.10,203.0.113.11
ADMIN_IP_SALT=CHANGE_ME_RANDOM
ADMIN_GAME_URL=https://bencaoyou.tryliang.me
ADMIN_BOOTSTRAP_USERNAME=owner
# Only read on first boot; the account is created once and the variable can be removed afterwards.
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARS
# Used only when ADMIN_BOOTSTRAP_PASSWORD is empty; must be writable by the service user.
ADMIN_BOOTSTRAP_FILE=/var/lib/bencao-admin/bootstrap-password
ADMIN_ROOT=/opt/bencao
ADMIN_STATIC_DIR=/opt/bencao/admin-dist
ADMIN_SNAPSHOT_PATH=/var/lib/bencao-admin/snapshot.json
